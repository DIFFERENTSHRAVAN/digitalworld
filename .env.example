# ====================================================================
# Digital World - Environment Variables Example
# ====================================================================

# 1. Supabase Project Credentials (Optional for local testing, required for live DB)
# Leave empty or omitted to run in working Local Development / Demo Mode.
# Once created at https://supabase.com, paste your live credentials below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Production URL (Used for generating Open Graph and shareable product links)
VITE_SITE_URL=https://digitalworld.in
